NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe — get from dashboard.stripe.com (optional; not available for PH merchants)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# PayMongo — get from dashboard.paymongo.com (primary PH payment gateway)
PAYMONGO_SECRET_KEY=sk_live_...
PAYMONGO_WEBHOOK_SECRET=whsec_...
PAYMONGO_AMOUNT_CENTS=19900

# Used as fallback for redirect URLs in non-browser contexts
NEXT_PUBLIC_APP_URL=https://your-domain.com
